// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int     @id @default(autoincrement()) // Rôle d'utilisateur (ex: admin, user)
  name  String  @unique // Nom du rôle
  users User[]
}

model User {
  id           Int     @id @default(autoincrement()) // ID de l'utilisateur

  username     String  @unique // Nom d'utilisateur unique
  email        String  @unique  // Adresse e-mail unique
  passwordHash String // Hash du mot de passe pour la sécurité
  roleId       Int  // Clé étrangère vers le rôle de l'utilisateur
  role         Role    @relation(fields: [roleId], references: [id]) // Relation avec le modèle Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Offer {
  id           Int      @id @default(autoincrement())
  externalId   String?  @unique // Pour lier à MongoDB si besoin
  title        String   // Titre de l'offre d'emploi
  description  String   // Description de l'offre d'emploi
  company      String   // Nom de l'entreprise
  location     String   // Localisation de l'offre
  date         DateTime? // Date de publication
  salary       String?  // Salaire
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
