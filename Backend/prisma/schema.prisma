generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordhash String
  name         String?
  surname      String?
  age          Int?
  address      String?
  Schools      String?
  Projects     String?
  Technologies String?
  Skills       String?
  createdAt    DateTime @default(now())
}

model Job {
  id          Int          @id @default(autoincrement())
  name        String
  descriptionmini String
  description   String
  company     String
  type        String
  experience  Int?
  skills      Skills[]
  createdAt   DateTime     @default(now())
  analytics   Analytics?
  geolocation GeoLocation?
  salary      Salary?
}

model Analytics {
  id                 Int      @id @default(autoincrement())
  applications       Int      @default(0)
  applyBtnClicks     Int      @default(0)
  atsApplications    Int      @default(0)
  cta                Float    @default(0)
  ctr                Float      @default(0)
  remoteApplications Int      @default(0)
  totalApplications  Int      @default(0)
  updatedAt          DateTime @default(now())
  visitsCount        Int      @default(0)
  jobId              Int      @unique
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model GeoLocation {
  id        Int     @id @default(autoincrement())
  latitude  Float   @default(0)
  longitude Float   @default(0)
  city      String?
  country   String?
  jobId     Int     @unique
  jobs      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Salary {
  id       Int     @id @default(autoincrement())
  max      Int
  min      Int
  currency String?
  jobId    Int     @unique
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Skills {
  id        Int      @id @default(autoincrement())
  name      String?
  value     Int?
  jobId     Int      
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}